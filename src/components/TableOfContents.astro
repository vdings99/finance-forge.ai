---
interface Heading {
  text: string
  slug: string
  depth: number
}

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
// Only top-level H2s for the TOC
const h2s = headings.filter(h => h.depth === 2)
---

{h2s.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc__label">Contents</p>
    <ol class="toc__list" role="list">
      {h2s.map((h, i) => (
        <li class="toc__item">
          <span class="toc__num data">{String(i + 1).padStart(2, '0')}</span>
          <a href={`#${h.slug}`} class="toc__link">{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
