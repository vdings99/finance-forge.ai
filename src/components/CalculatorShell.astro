---
interface Props {
  title: string
  footnote?: string
}

const { title, footnote } = Astro.props
---

<div class="calc-shell">
  <div class="calc-shell__header">
    <h2 class="calc-shell__title">{title}</h2>
  </div>
  <div class="calc-shell__body">
    <div class="calc-shell__inputs">
      <!-- Inputs are supplied by the page via the 'inputs' slot -->
      <slot name="inputs" />
    </div>
    <div class="calc-shell__results">
      <!-- Results are supplied by the page via the 'results' slot -->
      <slot name="results" />
    </div>
  </div>
  {footnote && (
    <p class="calc-shell__footnote">{footnote}</p>
  )}
</div>
