---
import { getCollection } from 'astro:content'
import PageLayout from '../layouts/PageLayout.astro'

export async function getStaticPaths() {
  // pages/ collection — exclude 'index' which is handled by src/pages/index.astro
  const pages = await getCollection('pages')
  const pageRoutes = pages
    .filter(p => p.slug !== 'index')
    .map(page => ({
      params: { slug: page.slug },
      props: { page, collectionType: 'pages' as const },
    }))

  // articles/ collection
  const articles = await getCollection('articles')
  const articleRoutes = articles.map(article => ({
    params: { slug: article.slug },
    props: { page: article, collectionType: 'articles' as const },
  }))

  return [...pageRoutes, ...articleRoutes]
}

const { page, collectionType } = Astro.props
const { Content, headings } = await page.render()
const { title, description, breadcrumb, revised, toc, lead } = page.data
const archetype = collectionType === 'articles' ? 'article' : (page.data as any).archetype
---

<PageLayout
  title={title}
  description={description}
  breadcrumb={breadcrumb}
  archetype={archetype}
  revised={revised}
  toc={toc}
  lead={lead}
  headings={headings}
>
  <Content />
</PageLayout>
