---
/*
 * PageLayout — universal page wrapper.
 *
 * Routes to the correct layout anatomy based on `archetype`:
 *   hub | province | glossary | log → HubLayout / ProvinceLayout / GlossaryLayout / LogLayout
 *   article | datatable             → ArticleLayout / DataPageLayout
 *   calculator                      → CalculatorLayout
 *   utility | home                  → existing inline behavior
 *
 * The new specialised layouts can also be imported directly from pages when
 * more granular props are needed. This wrapper keeps backward compatibility
 * for the dynamic [...slug].astro catch-all route.
 */
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import TableOfContents from '../components/TableOfContents.astro'
import RevisedTag from '../components/RevisedTag.astro'

interface Heading {
  text: string
  slug: string
  depth: number
}

interface Props {
  title: string
  description?: string
  breadcrumb?: string[]
  archetype?: 'home' | 'hub' | 'article' | 'datatable' | 'calculator' | 'utility' | 'province' | 'glossary' | 'log'
  revised?: string
  toc?: boolean
  lead?: string
  headings?: Heading[]
  taxYear?: number
  preview?: boolean
}

const {
  title,
  description,
  breadcrumb = ['Home'],
  archetype = 'utility',
  revised,
  toc = false,
  lead,
  headings = [],
  taxYear,
  preview = false,
} = Astro.props

const showToc = toc && headings.filter(h => h.depth === 2).length > 0

// Determine content column class
const useArticleGrid = archetype === 'article' || archetype === 'datatable'
const useProse = archetype === 'article' || archetype === 'datatable'
---

<BaseLayout title={title} description={description} taxYear={taxYear}>
  <Header />

  <main id="main-content" class="page-main">
    <div class="container">

      {archetype === 'home'
        ? <slot />
        : (
            <>
              <Breadcrumb crumbs={breadcrumb} currentTitle={title} />

              <div class:list={['grid-12', useArticleGrid && 'article-grid']}>

                {/* Main content column */}
                <div class:list={[
                  useArticleGrid ? 'col-prose' : 'col-full'
                ]}>

                  <h1 class="page-h1">{title}</h1>

                  {lead && <p class="lead">{lead}</p>}

                  {preview && (
                    <div class="preview-banner" role="status">
                      <p>Preview — This calculator's interface is shown for reference. The calculation engine is in development and will be activated in a future update.</p>
                    </div>
                  )}

                  {showToc && <TableOfContents headings={headings} />}

                  <div class:list={[useProse && 'prose']}>
                    <slot />
                  </div>

                  {revised && <RevisedTag date={revised} />}
                </div>

                {/* Article aside column (deliberately left empty — whitespace is the design) */}
                {useArticleGrid && <aside class="col-aside" aria-hidden="true"></aside>}

              </div>
            </>
          )
      }

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Article prose offset grid */
  @media (min-width: 1024px) {
    .article-grid {
      align-items: start;
    }
  }
</style>
